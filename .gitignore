!Reports/Inputs/
*.pdf

# Build outputs
bin/
obj/
*.dll
*.exe
*.pdb

# Python / Node caches
__pycache__/
*.pyc
.pytest_cache/
node_modules/

# Logs and OS files
*.log
Thumbs.db
desktop.ini
.DS_Store
